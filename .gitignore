# deps
node_modules/
.pnpm-store/

# builds
dist/
build/
.output/
.wxt/
.astro/
apps/extension/.wxt/
apps/extension/.output/

# caches
.turbo/
*.tsbuildinfo
.vite/
.cache/
.eslintcache

# local data (user's private corpus — never commit)
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
.models/

# env & secrets
.env
.env.*
!.env.example

# Agent config: the skills in .claude/skills/ are shared on purpose, but the
# settings files hold machine-local permissions and MCP endpoints.
.claude/settings.local.json
.claude/*.local.json

# os / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# logs
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# screenshots workspace (generated artifacts are committed selectively under assets/)
.playwright/
test-results/
playwright-report/

# Screenshot fixtures (regenerate with `pnpm screenshots`)
data/screenshots/
