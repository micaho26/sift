{
  "name": "sift-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sift local API server: ingestion, hybrid search, scoring, AI.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch-path=src --enable-source-maps --no-warnings=ExperimentalWarning src/index.ts",
    "start": "node --enable-source-maps --no-warnings=ExperimentalWarning dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "node --enable-source-maps --no-warnings=ExperimentalWarning src/cli/seed.ts",
    "db:reset": "node --enable-source-maps --no-warnings=ExperimentalWarning src/cli/reset.ts",
    "test": "node --test --no-warnings=ExperimentalWarning test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "@hono/zod-validator": "0.9.0",
    "@sift/core": "workspace:*",
    "hono": "4.12.32",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.2",
    "typescript": "5.9.3"
  }
}
