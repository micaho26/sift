---
/**
 * Base layout: head, nav, footer, and the scroll-reveal observer.
 */
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Sift — signal intelligence for technologists',
  description = 'A local-first AI intelligence workstation. Harvest high-signal AI news from X, Xiaohongshu, Hacker News, arXiv and GitHub; score it, search it in any language, and turn it into briefings. Runs entirely on your machine.',
} = Astro.props

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const repo = 'https://github.com/micaho26/sift'
const canonical = new URL(Astro.url.pathname, Astro.site).href

const nav = [
  { href: '#how', label: 'How it works' },
  { href: '#scoring', label: 'Scoring' },
  { href: '#features', label: 'Features' },
  { href: '#start', label: 'Get started' },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${Astro.site}${base.slice(1)}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#0d0d14" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'Sift',
        applicationCategory: 'BrowserApplication',
        operatingSystem: 'macOS, Linux, Windows',
        description,
        license: 'https://opensource.org/licenses/MIT',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      })}
    />
  </head>

  <body>
    <!-- Ambient background. Fixed and pointer-events-none so it never interferes. -->
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div
        class="absolute left-1/2 top-[-18%] h-[620px] w-[1100px] -translate-x-1/2 rounded-full opacity-[0.55] blur-[120px]"
        style="background: radial-gradient(closest-side, oklch(46% 0.17 285 / 0.5), transparent)"
      >
      </div>
      <div
        class="absolute right-[-12%] top-[42%] h-[520px] w-[720px] rounded-full opacity-40 blur-[130px]"
        style="background: radial-gradient(closest-side, oklch(48% 0.12 195 / 0.35), transparent)"
      >
      </div>
      <!-- 1px grid, masked so it fades out rather than ending on a hard line. -->
      <div
        class="absolute inset-0 opacity-[0.055]"
        style="background-image: linear-gradient(oklch(100% 0 0 / 0.6) 1px, transparent 1px), linear-gradient(90deg, oklch(100% 0 0 / 0.6) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 90% 55% at 50% 0%, #000 35%, transparent 78%)"
      >
      </div>
    </div>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-bg-elevated focus:px-3 focus:py-2 focus:text-sm"
      >Skip to content</a
    >

    <!-- nav -->
    <header class="sticky top-0 z-40 border-b border-border-subtle/70 bg-[oklch(11%_0.012_285/0.72)] backdrop-blur-xl">
      <div class="container-page flex h-14 items-center gap-6">
        <a href={base || '/'} class="flex items-center gap-2.5 shrink-0" aria-label="Sift home">
          <svg width="19" height="19" viewBox="0 0 24 24" class="text-accent">
            <path d="M2 12 L12 2 L22 12 L12 22 Z" fill="currentColor"></path>
          </svg>
          <span class="text-[15px] font-semibold tracking-[-0.015em]">Sift</span>
        </a>

        <nav class="hidden items-center gap-1 md:flex" aria-label="Sections">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="rounded-md px-2.5 py-1.5 text-[13px] text-fg-tertiary transition-colors hover:bg-bg-subtle hover:text-fg"
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="ml-auto flex items-center gap-2">
          <a
            href={`${repo}/stargazers`}
            class="hidden items-center gap-1.5 rounded-md border border-border px-2.5 py-1.5 text-[12px] text-fg-secondary transition-colors hover:bg-bg-subtle hover:text-fg sm:flex"
          >
            <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"
              ><path
                d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"
              ></path></svg
            >
            Star
          </a>
          <a
            href={repo}
            class="flex items-center gap-1.5 rounded-md bg-fg px-3 py-1.5 text-[12px] font-medium text-bg transition-all hover:brightness-90"
          >
            <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor"
              ><path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.07-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A7.995 7.995 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              ></path></svg
            >
            GitHub
          </a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <!-- footer -->
    <footer class="mt-24 border-t border-border-subtle">
      <div class="container-page py-12">
        <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
          <div class="max-w-sm">
            <div class="flex items-center gap-2.5">
              <svg width="17" height="17" viewBox="0 0 24 24" class="text-accent">
                <path d="M2 12 L12 2 L22 12 L12 22 Z" fill="currentColor"></path>
              </svg>
              <span class="text-sm font-semibold">Sift</span>
            </div>
            <p class="mt-3 text-[13px] leading-relaxed text-fg-tertiary">
              Signal Intelligence For Technologists. An open-source, local-first workstation for the AI firehose.
            </p>
            <p class="mt-3 font-mono text-[11px] text-fg-quaternary">MIT licensed · no account · no telemetry</p>
          </div>

          <div class="grid grid-cols-2 gap-x-12 gap-y-6 text-[13px] sm:grid-cols-3">
            <div>
              <h3 class="mb-2.5 text-[11px] font-semibold uppercase tracking-wider text-fg-quaternary">Product</h3>
              <ul class="space-y-2 text-fg-tertiary">
                <li><a href="#how" class="transition-colors hover:text-fg">How it works</a></li>
                <li><a href="#scoring" class="transition-colors hover:text-fg">Signal scoring</a></li>
                <li><a href="#features" class="transition-colors hover:text-fg">Features</a></li>
                <li><a href="#privacy" class="transition-colors hover:text-fg">Privacy</a></li>
              </ul>
            </div>
            <div>
              <h3 class="mb-2.5 text-[11px] font-semibold uppercase tracking-wider text-fg-quaternary">Docs</h3>
              <ul class="space-y-2 text-fg-tertiary">
                <li><a href={`${repo}#quick-start`} class="transition-colors hover:text-fg">Quick start</a></li>
                <li><a href={`${repo}/blob/main/docs/ARCHITECTURE.md`} class="transition-colors hover:text-fg">Architecture</a></li>
                <li><a href={`${repo}/blob/main/docs/SCORING.md`} class="transition-colors hover:text-fg">Scoring model</a></li>
                <li><a href={`${repo}/blob/main/docs/EXTENSION.md`} class="transition-colors hover:text-fg">Extension</a></li>
              </ul>
            </div>
            <div>
              <h3 class="mb-2.5 text-[11px] font-semibold uppercase tracking-wider text-fg-quaternary">Project</h3>
              <ul class="space-y-2 text-fg-tertiary">
                <li><a href={repo} class="transition-colors hover:text-fg">Source</a></li>
                <li><a href={`${repo}/issues`} class="transition-colors hover:text-fg">Issues</a></li>
                <li><a href={`${repo}/blob/main/CONTRIBUTING.md`} class="transition-colors hover:text-fg">Contributing</a></li>
                <li><a href={`${repo}/blob/main/LICENSE`} class="transition-colors hover:text-fg">MIT License</a></li>
              </ul>
            </div>
          </div>
        </div>

        <div class="mt-10 flex flex-col gap-2 border-t border-border-subtle pt-6 text-[11px] text-fg-quaternary sm:flex-row sm:items-center sm:justify-between">
          <p>Built to be read, forked and disagreed with.</p>
          <p class="font-mono">Sift v0.1.0</p>
        </div>
      </div>
    </footer>

    <script>
      // Reveal on scroll. One observer for the whole page, unobserving after the
      // first intersection so nothing re-animates on scroll-back.
      const targets = document.querySelectorAll('.reveal, .reveal-stagger')
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue
              entry.target.classList.add('in-view')
              observer.unobserve(entry.target)
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
        )
        for (const target of targets) observer.observe(target)
      } else {
        for (const target of targets) target.classList.add('in-view')
      }

      // Copy-to-clipboard for every command block.
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        button.addEventListener('click', async () => {
          const text = button.getAttribute('data-copy') ?? ''
          try {
            await navigator.clipboard.writeText(text)
            const original = button.getAttribute('data-label') ?? 'Copy'
            button.textContent = 'Copied'
            setTimeout(() => (button.textContent = original), 1400)
          } catch {
            // Clipboard denied; the command is visible anyway.
          }
        })
      }
    </script>
  </body>
</html>
